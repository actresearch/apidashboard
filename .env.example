# GHCR image used by Portainer stack
GHCR_IMAGE=ghcr.io/actresearch/apidashboard:latest

# Host port mapped to container port 5005
APP_PORT=5005

# Absolute host path for the bind mount on the Docker server
DASHBOARD_LOG_PATH=/opt/api-dashboard/logs
PORT_MONITOR_STATUS_PATH=/app/logs/Major US Port Data Monitor.status.json
PORT_MONITOR_STATUS_URL=
PORT_MONITOR_STATUS_TOKEN=
AUTOMATION_STATUS_DIR=/app/logs/automations
AUTOMATION_STATUS_PATHS=
AUTOMATION_STATUS_TOKEN=
AUTOMATION_CONTROL_URL=http://192.168.1.109:5015
AUTOMATION_CONTROL_TOKEN=
AUTOMATION_OPERATOR_TOKEN=
DASHBOARD_ZOOM_WEBHOOK_URL=
DASHBOARD_ZOOM_WEBHOOK_TOKEN=
DASHBOARD_ZOOM_DEDUPE_SECONDS=1800
DASHBOARD_ZOOM_DAILY_STATUS_ENABLED=true
DASHBOARD_ZOOM_DAILY_STATUS_TIME=08:00
DASHBOARD_ZOOM_DAILY_STATUS_TZ=America/New_York
DASHBOARD_ZOOM_DAILY_STATUS_STATE_PATH=/app/logs/zoom_daily_status_state.json
API_HEALTH_STREAM_URL=http://192.168.1.17:5002/stream
WATCHDOG_STREAM_URL=http://192.168.1.17:8001/stream
FTP_STREAM_URL=http://192.168.1.17:5000/stream
WORK_STATUS_STALE_MINUTES=120
FTP_EMAIL_STATUS_URL=
FTP_EMAIL_STATUS_TOKEN=
FTP_STATUS_MONITOR_INTERVAL=60
STREAM_PROXY_ALERT_AFTER_FAILURES=3

# Supabase API request log source for 30-day dashboard usage lists
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_USAGE_SNAPSHOT_TABLE=api_usage_stats_snapshot
USAGE_STATS_CACHE_SECONDS=86400
